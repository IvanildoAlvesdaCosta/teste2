  <style>
    .article-page {
      padding-top: 80px;
      padding-bottom: 8rem;
    }

    .article-header {
      padding: 6rem 0 3rem;
    }

    .meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
      color: var(--text-muted);
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .category {
      color: var(--primary);
      font-weight: 600;
    }

    h1 {
      font-size: 3.5rem;
      line-height: 1.1;
      margin-bottom: 2rem;
      max-width: 900px;
    }

    .lead {
      font-size: 1.25rem;
      color: var(--text-muted);
      max-width: 800px;
      line-height: 1.6;
    }

    .article-container {
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: 4rem;
    }

    .article-content {
      font-size: 1.125rem;
      line-height: 1.8;
      color: var(--text-main);
    }

    section {
      margin-bottom: 3rem;
    }

    h2 {
      font-size: 2rem;
      margin-bottom: 1.5rem;
      color: var(--text-main);
    }

    h3 {
      font-size: 1.5rem;
      margin: 2rem 0 1rem;
      color: var(--text-main);
    }

    p {
      margin-bottom: 1.5rem;
    }

    ul, ol {
      margin-left: 1.5rem;
      margin-bottom: 1.5rem;
    }

    li {
      margin-bottom: 0.5rem;
    }

    .article-sidebar {
      position: sticky;
      top: 100px;
      height: fit-content;
    }

    .sidebar-card {
      background: var(--glass);
      border: 1px solid var(--glass-border);
      padding: 2rem;
      border-radius: 1.5rem;
    }

    .back-link {
      display: inline-block;
      margin-top: 1rem;
      color: var(--primary);
      font-weight: 600;
    }

    @media (max-width: 1024px) {
      .article-container {
        grid-template-columns: 1fr;
      }
      .article-sidebar {
        position: static;
      }
    }

    @media (max-width: 768px) {
      h1 {
