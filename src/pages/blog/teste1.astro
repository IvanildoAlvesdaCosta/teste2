  </article>

  <style>
    .article-page {
      padding-top: 80px;
      padding-bottom: 8rem;
    }

    .article-header {
      padding: 6rem 0 3rem;
    }

    .meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
      color: var(--text-muted);
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .category {
      color: var(--primary);
      font-weight: 600;
    }

    h1 {
      font-size: 3.5rem;
      line-height: 1.1;
      margin-bottom: 2rem;
      max-width: 900px;
    }

    .lead {
      font-size: 1.25rem;
      color: var(--text-muted);
      max-width: 800px;
      line-height: 1.6;
    }

    .article-container {
      display: grid;
