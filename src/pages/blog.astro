---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import BlogCard from '../components/BlogCard';

const posts = [
  {
    title: "Melhor Parafusadeira para Montar Móveis (Sem Estragar MDF)",
    excerpt: "Guia completo com as melhores opções de parafusadeiras para montagem de móveis, focando em precisão e controle de torque.",
    date: "24 de Abril, 2026",
    url: "/blog/teste1",
    featured: true
  },
  {
    title: "Como DESAFOGAR uma roçadeira",
    excerpt: "Para desafogar uma roçadeira, o primeiro passo é identificar se o problema está no carburador, na vela ou no filtro de ar.",
    date: "24 de Abril, 2026",
    url: "/blog/teste2",
    featured: false
  },
  {
    title: "Como desafogar uma Roçadeira - MENOS DE 2 MINUTOS!",
    excerpt: "Para desafogar a roçadeira rapidamente, comece desligando o motor e afastando-se da área de trabalho para evitar acidentes.",
    date: "24 de Abril, 2026",
    url: "/blog/teste3",
    featured: false
  },
  {
    title: "COMO DESAFOGAR UMA ROÇADEIRA",
    excerpt: "Desafogar uma roçadeira é uma dúvida comum. Aprenda o passo a passo para modelos das marcas Makita, Husqvarna, Vulcan e Stihl.",
    date: "24 de Abril, 2026",
    url: "/blog/teste4",
    featured: false
  }
];
---

<Layout title="Blog - AstroBun Test Site">
  <Navbar client:load />
  
  <main className="blog-page">
    <section className="blog-hero">
      <div className="container">
        <h1 className="animate-fade">Nosso <span>Blog</span></h1>
        <p className="animate-fade" style="animation-delay: 0.2s">Dicas, reviews e guias práticos sobre ferramentas e manutenção.</p>
      </div>
    </section>

    <section className="blog-content">
      <div className="container">
        <div className="posts-grid">
          {posts.map(post => (
            <BlogCard {...post} client:visible />
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div className="container footer-content">
      <p>&copy; 2026 AstroBun Test Site. Desenvolvido com Antigravity.</p>
    </div>
  </footer>

  <style>
    .blog-page {
      padding-top: 80px;
    }

    .blog-hero {
      padding: 6rem 0 4rem;
      text-align: center;
      background: radial-gradient(circle at center, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
    }

    h1 {
      font-size: 4rem;
      margin-bottom: 1.5rem;
    }

    h1 span {
      background: linear-gradient(to right, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .blog-hero p {
      font-size: 1.25rem;
      color: var(--text-muted);
      max-width: 600px;
      margin: 0 auto;
    }

    .blog-content {
      padding: 4rem 0 8rem;
    }

    .posts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    footer {
      padding: 4rem 0;
      border-top: 1px solid var(--glass-border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    @media (max-width: 768px) {
      h1 {
        font-size: 2.5rem;
      }
      
      .posts-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
