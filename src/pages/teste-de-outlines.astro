<style>
  .article-test {
    padding: 120px 1.5rem 80px;
    max-width: 900px;
    line-height: 1.6;
    color: var(--text-main);
  }
  h1 {
    font-size: 3rem;
    margin-bottom: 2.5rem;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  h2 {
    font-size: 1.8rem;
    margin-top: 3rem;
